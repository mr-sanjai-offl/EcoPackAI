# ==========================================
# ECOPACK AI - ENVIRONMENT CONFIGURATION
# ==========================================
# IMPORTANT: Never commit actual .env files to version control!
# Copy this file to .env and fill in the values for your environment.

# ------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------
ENVIRONMENT=production
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=replace_this_with_a_highly_secure_random_string

# ------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------
# These credentials will be used to initialize the Docker Postgres container
POSTGRES_USER=ecopack_admin
POSTGRES_PASSWORD=super_secure_db_password_123!
POSTGRES_DB=ecopack_production_db

# ------------------------------------------
# CACHE (Redis)
# ------------------------------------------
REDIS_PASSWORD=super_secure_redis_password_123!

# ------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------
# Base URL for the frontend to call the API.
# When using Nginx Reverse Proxy on the same domain, this can be relative.
NEXT_PUBLIC_API_URL=/api/v1
